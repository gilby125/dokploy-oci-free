# Copy to pgbackrest.conf on the host (gitignored — contains R2 keys + cipher pass).
[global]
repo1-type=s3
repo1-s3-endpoint=<ACCOUNT>.r2.cloudflarestorage.com
repo1-s3-bucket=agentplane-prod
repo1-s3-region=us-east-1
repo1-s3-uri-style=path
repo1-s3-key=<R2_ACCESS_KEY>
repo1-s3-key-secret=<R2_SECRET_KEY>
repo1-path=/pgbackrest
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=<CIPHER_PASS>
repo1-retention-full=1
start-fast=y
compress-type=zst
log-level-console=info

repo1-retention-archive=1
repo1-retention-archive-type=full
[agentplane]
pg1-user=agentplane
pg1-path=/var/lib/postgresql/data
