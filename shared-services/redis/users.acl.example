# Shared Redis ACL — fleet data service on oci-w3 (10.0.0.244:6379).
# Copy to users.acl on the node and replace each <...> with a strong unique
# secret (openssl rand -base64 24). The real users.acl is gitignored — it is
# the ONLY copy of these passwords besides the consuming Komodo stack envs.
#
# default: anonymous connections can do nothing but PING (no key access at all),
#   so external reachability alone grants nothing. protected-mode is off because
#   the bind is VCN-private (Docker publishes only to 10.0.0.244) and the OCI
#   security list blocks public :6379 — auth + network isolation are the boundary.
# admin:   full access, for operators only.
# per-app: full data access on all keys, minus @dangerous (no FLUSHALL/FLUSHDB/
#   KEYS/CONFIG/etc). One user per app; never share credentials between apps.
user default on nopass ~* &* -@all +ping
user admin on >password ~* &* +@all
user agentplane on >password ~* &* +@all -@dangerous
user ads_node on >password ~* &* +@all -@dangerous
user baseballz on >password ~* &* +@all -@dangerous
